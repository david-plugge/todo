# Exact external origin. Production requires HTTPS; HTTP is accepted only on localhost/loopback.
TODO_PUBLIC_URL=http://127.0.0.1:8090

# Generate and store this outside Git. It must contain exactly 32 single-byte characters.
PB_ENCRYPTION_KEY=

# Leave both empty for direct deployments. Behind a reverse proxy, set both;
# prefer an exact /32 or /128 for the proxy's direct connection address.
TODO_TRUSTED_PROXY_HEADER=
TODO_TRUSTED_PROXY_CIDRS=

FREIRAUM_BIND_ADDRESS=127.0.0.1
FREIRAUM_PORT=8090
FREIRAUM_TAG=local

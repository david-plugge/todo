{
  "name": "freiraum",
  "description": "Local-first Aufgabenverwaltung",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:harness": "TODO_BUILD_TARGET=harness vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:browser": "pnpm run build:harness && playwright test",
    "test:pwa": "pnpm run build && playwright test --config playwright.product-pwa.config.ts",
    "test:pocketbase": "pnpm run build && playwright test --config playwright.pocketbase.config.ts",
    "backend": ".tools/freiraum serve --http=127.0.0.1:8090 --dir=pb_data --publicDir=pb_public",
    "backend:install": "pnpm run backend:build",
    "test:startup": "playwright test --config playwright.pocketbase.config.ts server-start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run check && pnpm test && pnpm run backend:check && pnpm run backend:build && pnpm run build",
    "test:e2e": "pnpm run test:browser && pnpm run test:pwa && pnpm run test:pocketbase",
    "test:container": "node tests/deployment/container-smoke.mjs",
    "test:restore": "node tests/deployment/restore-smoke.mjs",
    "backend:build": "mise run backend:build",
    "backend:format": "mise run backend:format",
    "backend:check": "mise run backend:check"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.46.0",
    "@tanstack/db": "0.9.2",
    "@tanstack/svelte-db": "0.4.1",
    "bits-ui": "2.19.2",
    "dexie": "4.4.6",
    "pocketbase": "0.28.1",
    "rrule": "2.8.1",
    "svelte": "5.57.0",
    "svelte-dnd-action": "0.9.79"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.20.2",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "fake-indexeddb": "6.2.5",
    "globals": "17.12.0",
    "lucide-static": "1.46.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.4.1"
}
